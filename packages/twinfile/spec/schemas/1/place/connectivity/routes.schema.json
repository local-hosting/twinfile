{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twinfile.org/schemas/1/place/routes.schema.json",
  "type": "object",
  "required": ["routes"],
  "properties": {
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "from", "to", "length_m", "kind", "step_free"],
        "properties": {
          "id": { "$ref": "https://twinfile.org/schemas/1/defs.json#/$defs/twinId" },
          "name": { "type": "string" },
          "from": { "$ref": "https://twinfile.org/schemas/1/defs.json#/$defs/twinId" },
          "to": { "$ref": "https://twinfile.org/schemas/1/defs.json#/$defs/twinId" },
          "length_m": { "type": "number", "exclusiveMinimum": 0 },
          "kind": {
            "enum": ["corridor", "stair", "ramp", "elevator", "escalator", "moving_sidewalk", "path"]
          },
          "step_free": { "type": "boolean" },
          "roles": { "type": "array", "items": { "type": "string" } },
          "ext": { "type": "object" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
