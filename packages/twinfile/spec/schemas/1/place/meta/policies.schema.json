{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twinfile.org/schemas/1/place/meta/policies.schema.json",
  "type": "object",
  "required": ["policies"],
  "properties": {
    "policies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "purpose"],
        "properties": {
          "id": { "$ref": "https://twinfile.org/schemas/1/defs.json#/$defs/twinId" },
          "purpose": { "type": "string" },
          "odrl": { "type": "object" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
