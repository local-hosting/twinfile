{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twinfile.org/schemas/1/place/spaces.schema.json",
  "type": "object",
  "required": ["spaces"],
  "properties": {
    "spaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
        "type": "object",
        "required": ["id", "kind"],
        "properties": {
          "id": { "$ref": "https://twinfile.org/schemas/1/defs.json#/$defs/twinId" },
          "name": { "type": "string" },
          "kind": { "type": "string" },
          "level": { "$ref": "https://twinfile.org/schemas/1/defs.json#/$defs/twinId" },
          "parent": { "$ref": "https://twinfile.org/schemas/1/defs.json#/$defs/twinId" },
          "capacity": { "type": "integer", "minimum": 0 },
          "area_m2": { "type": "number", "exclusiveMinimum": 0 },
          "exposure": { "enum": ["indoor", "covered", "outdoor"] },
          "state": { "type": "string" },
          "geometry": {
            "type": "object",
            "required": ["ref"],
            "properties": { "ref": { "type": "string" } },
            "additionalProperties": false
          },
          "roles": { "type": "array", "items": { "type": "string" } },
          "visit_order": { "type": "integer", "minimum": 0 },
          "ext": { "type": "object" }
        },
        "additionalProperties": false
          },
          { "$ref": "https://twinfile.org/schemas/1/defs.json#/$defs/mergeDeletePatch" }
        ]
      }
    }
  },
  "additionalProperties": false
}
