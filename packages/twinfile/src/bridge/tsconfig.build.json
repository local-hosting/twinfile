{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "declaration": true,
    "noEmit": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "customConditions": []
  },
  "include": [
    "**/*.ts"
  ],
  "exclude": [
    "dist",
    "**/*.test.ts",
    "test"
  ]
}
