{
  "note": "RFC 0004 place axes. Each case builds a place (default archetype single_level) and checks the archetype derived from its axes.",
  "cases": [
    {
      "id": "axes-derive",
      "archetype": null,
      "axes": { "extent": "area", "vertical": "flat", "movement": "free" },
      "expectArchetype": "open_area"
    },
    {
      "id": "axes-derive-stacked",
      "archetype": null,
      "axes": { "extent": "footprint", "vertical": "stacked", "movement": "free" },
      "expectArchetype": "indoor_stack"
    },
    { "id": "axes-incomplete", "archetype": null, "axes": { "vertical": "stacked" }, "expectCodes": ["E_ARCHETYPE_AXES"] },
    { "id": "archetype-mismatch", "archetype": "indoor_stack", "axes": { "extent": "site" }, "expectCodes": ["E_ARCHETYPE_AXES_MISMATCH"] }
  ]
}
