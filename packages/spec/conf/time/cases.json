    {
      "id": "feed-known-lags-value",
      "timezone": "America/New_York",
      "clock": { "starts_at": "2026-06-12T09:00:00-04:00", "duration": "PT1H", "step": "PT30M" },
      "place": {
        "tracks": [
          { "id": "turbidity", "source": "feed", "device": "sonde", "property": "turbidity", "interpolate": "step" }
        ]
      },
      "feeds": [
        { "device_id": "sonde", "observed_property": "turbidity", "value": 1, "observed_at": "2026-06-12T09:00:00-04:00", "available_at": "2026-06-12T10:00:00-04:00" },
        { "device_id": "sonde", "observed_property": "turbidity", "value": 3, "observed_at": "2026-06-12T09:30:00-04:00", "available_at": "2026-06-12T10:00:00-04:00" }
      ],
      "expect": [
        { "t": 1800, "tracks": { "turbidity": 3 }, "known": { "turbidity": null } },
        { "t": 3600, "tracks": { "turbidity": 3 }, "known": { "turbidity": 3 } }
      ]
    },
    {
      "id": "feed-linear-and-quality-gap",
      "timezone": "America/New_York",
      "clock": { "starts_at": "2026-06-12T09:00:00-04:00", "duration": "PT20M", "step": "PT5M" },
      "place": {
        "tracks": [{ "id": "stage", "source": "feed", "device": "gauge", "property": "stage" }]
      },
      "feeds": [
        { "device_id": "gauge", "observed_property": "stage", "value": 4, "observed_at": "2026-06-12T09:00:00-04:00" },
        { "device_id": "gauge", "observed_property": "stage", "value": 99, "observed_at": "2026-06-12T09:05:00-04:00", "quality": "fouled" },
        { "device_id": "gauge", "observed_property": "stage", "value": 8, "observed_at": "2026-06-12T09:10:00-04:00" }
      ],
      "expect": [
        { "t": 300, "tracks": { "stage": 6 }, "known": { "stage": 4 } },
        { "t": 1200, "tracks": { "stage": 8 } }
      ]
    },
    {
      "id": "solar-noon-and-night",
      "timezone": "America/New_York",
      "location": { "lat": 40.758, "lng": -73.9855 },
      "clock": { "starts_at": "2026-06-21T00:00:00-04:00", "duration": "PT13H", "step": "PT1H" },
      "place": { "tracks": [{ "id": "daylight", "source": "solar" }] },
