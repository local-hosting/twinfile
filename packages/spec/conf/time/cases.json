        { "t": 46800, "range": { "track": "daylight", "min": 70, "max": 74 } }
      ]
    },
    {
      "id": "schedule-gated-by-daylight",
      "timezone": "America/New_York",
      "location": { "lat": 41.309, "lng": -74.152 },
      "clock": { "starts_at": "2026-06-12T02:00:00-04:00", "duration": "PT8H", "step": "PT1H" },
      "place": {
        "schedules": [
          {
            "id": "shore-work",
            "when": "Mo-Su 06:00-20:00",
            "uses": { "space": "eddy-pool" },
            "activeWhen": { "track": "daylight", "min": 0 }
          }
        ],
        "tracks": [
          { "id": "daylight", "source": "solar" },
          { "id": "working", "source": "schedule", "schedule": "shore-work" }
        ]
      },
      "expect": [
        { "t": 0, "active": [], "tracks": { "working": 0 }, "occupancy": [] },
        {
          "t": 21600,
          "active": ["shore-work"],
          "tracks": { "working": 1 },
          "occupancy": [{ "schedule": "shore-work", "space": "eddy-pool" }]
        }
      ]
    },
    {
      "id": "simulate-uplink-known-lag",
      "timezone": "America/New_York",
      "clock": { "starts_at": "2026-06-12T09:00:00-04:00", "duration": "PT2H", "step": "PT30M" },
      "situations": [{ "phases": ["release"], "args": { "releaseAt": { "type": "time" } } }],
      "place": {
        "sensors": [
          {
            "id": "sonde",
            "observes": "pool",
            "properties": ["turbidity"],
            "simulate": {
              "every": "PT30M",
              "uplink": "PT1H",
              "turbidity": { "baseline": 10 }
            }
          }
        ],
        "tracks": [
          {
            "id": "turbidity",
            "source": "feed",
            "device": "sonde",
            "property": "turbidity",
            "interpolate": "step"
          }
        ]
      },
      "expect": [
        { "t": 1800, "tracks": { "turbidity": 10 }, "known": { "turbidity": null } },
        { "t": 3600, "tracks": { "turbidity": 10 }, "known": { "turbidity": 10 } }
      ]
    },
    {
      "id": "coverage-served-same-space-and-hop",
      "timezone": "America/New_York",
      "clock": { "starts_at": "2026-06-12T09:00:00-04:00", "duration": "PT1H", "step": "PT30M" },
      "place": {
        "spaces": [
          { "id": "ap-room", "kind": "room", "exposure": "indoor" },
          { "id": "hall", "kind": "corridor", "exposure": "indoor" },
          { "id": "yard", "kind": "yard", "exposure": "outdoor" }
        ],
        "assets": [
          { "id": "ap", "kind": "network", "space": "ap-room", "radio": { "protocol": "wifi", "tx_power_dbm": 20 } }
        ],
        "routes": [
          { "id": "r1", "from": "ap-room", "to": "hall", "length_m": 10, "kind": "corridor", "step_free": true }
        ],
        "openings": [
          { "id": "o1", "kind": "door", "connects": ["hall", "yard"], "width_m": 2, "state": "open" }
        ],
        "tracks": [
          { "id": "served-ap", "source": "coverage", "radio": "ap", "space": "ap-room", "metric": "served" },
          { "id": "served-yard", "source": "coverage", "radio": "ap", "space": "yard", "metric": "served", "threshold_dbm": -75 },
          { "id": "rssi-yard", "source": "coverage", "radio": "ap", "space": "yard", "metric": "rssi_dbm" }
        ]
      },
      "expect": [
        { "t": 0, "tracks": { "served-ap": 1, "served-yard": 0, "rssi-yard": -82.381813 }, "known": { "served-ap": 1, "served-yard": 0, "rssi-yard": -82.381813 } }
      ]
    }
  ]
}
