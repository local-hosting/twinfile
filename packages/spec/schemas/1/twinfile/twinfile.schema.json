{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twinfile.org/schemas/1/twinfile/twinfile.schema.json",
  "oneOf": [
    { "$ref": "#/$defs/placeTwinfile" },
    { "$ref": "#/$defs/eventTwinfile" },
    { "$ref": "#/$defs/scenarioTwinfile" },
    { "$ref": "#/$defs/characterTwinfile" },
    { "$ref": "#/$defs/storyTwinfile" },
    { "$ref": "#/$defs/resourceTwinfile" }
  ],
  "if": {
    "properties": { "kind": { "enum": ["place", "scenario", "character", "story", "resource", "event"] } },
    "required": ["kind"]
  },
  "else": {
    "$comment": "Unknown kinds require twinfile manifest version 1.",
    "properties": { "twinfile": { "const": 1 } }
  },
  "$defs": {
    "placeSteps": {
      "description": "Ordered steps (RFC 0009): one data patch, event bind, or copy per item; each step builds one deterministic layer.",
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["copy"],
            "properties": {
              "copy": { "type": "string", "minLength": 1 },
              "into": { "$ref": "https://twinfile.org/schemas/1/defs.json#/$defs/twinId" },
              "prefix": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["bind"],
            "properties": { "bind": { "type": "object" } },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["plan"],
            "properties": { "plan": { "type": "object" } },
            "additionalProperties": false
          },
          {
            "type": "object",
            "minProperties": 1,
            "not": { "anyOf": [{ "required": ["copy"] }, { "required": ["bind"] }, { "required": ["plan"] }] },
            "properties": { "mode": { "enum": ["patch", "replace"] } }
          }
        ]
      }
    },
    "placeTwinfile": {
      "allOf": [
        { "$ref": "https://twinfile.org/schemas/1/defs.json#/$defs/twinfileHead" },
        {
          "if": { "properties": { "twinfile": { "const": 2 } }, "required": ["twinfile"] },
          "then": {
            "anyOf": [{ "required": ["steps"] }, { "required": ["patches"] }, { "required": ["instructions"] }],
            "not": {
              "anyOf": [
                { "required": ["layers"] },
                { "required": ["with"] },
                { "required": ["buildings"] },
                { "required": ["patch"] },
                {
                  "allOf": [
                    { "required": ["steps"] },
                    { "anyOf": [{ "required": ["patches"] }, { "required": ["instructions"] }] }
                  ]
                }
              ]
            }
          },
          "else": {
            "required": ["layers"],
            "not": {
              "anyOf": [{ "required": ["steps"] }, { "required": ["patches"] }, { "required": ["buildings"] }, { "required": ["with"] }]
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "steps": { "$ref": "#/$defs/placeSteps" },
            "patches": { "$ref": "#/$defs/placeSteps" },
            "instructions": { "$ref": "#/$defs/placeSteps" },
            "kind": { "const": "place" },
            "from": { "$ref": "https://twinfile.org/schemas/1/defs.json#/$defs/twinfileRef" },
            "axes": { "$ref": "https://twinfile.org/schemas/1/defs.json#/$defs/placeAxes" },
            "layers": {
              "type": "array",
              "minItems": 1,
              "items": {
                "oneOf": [
                  { "type": "string", "minLength": 1 },
                  {
                    "type": "object",
                    "required": ["path"],
                    "properties": {
                      "path": { "type": "string", "minLength": 1 },
                      "mode": { "enum": ["patch", "replace"] }
                    },
                    "additionalProperties": false
                  }
                ]
              }
            },
            "geotype": {
              "$ref": "https://twinfile.org/schemas/1/defs.json#/$defs/geotypeTwinfile"
            },
            "bridges": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["id", "bridge"],
                "properties": {
                  "id": { "$ref": "https://twinfile.org/schemas/1/defs.json#/$defs/twinId" },
                  "bridge": { "type": "string", "minLength": 1 },
                  "role": { "enum": ["import", "export", "geometry"] }
                },
                "additionalProperties": false
              }
            },
            "sources": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "processors": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "https://twinfile.org/schemas/1/patch/patch-graph.schema.json#/$defs/manifestProcessor" }
            },
            "patch": {
              "$ref": "https://twinfile.org/schemas/1/patch/patch-graph.schema.json",
              "description": "Deprecated: use processors: with outlets: on each processor."
            }
          }
        }
      ]
    },
    "eventTwinfile": {
      "description": "What happens at a place: ordered phases, expected roles, args. Timing lives on the scene (`schedule:`) or the simulator.",
      "allOf": [
        { "$ref": "https://twinfile.org/schemas/1/defs.json#/$defs/twinfileHead" },
        {
          "type": "object",
          "required": ["phases", "expects"],
          "properties": {
            "kind": { "const": "event" },
            "phases": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "https://twinfile.org/schemas/1/defs.json#/$defs/twinId" }
            },
            "expects": {
              "type": "object",
              "additionalProperties": {
                "$ref": "https://twinfile.org/schemas/1/defs.json#/$defs/expectsRole"
              }
            },
            "args": {
              "type": "object",
              "additionalProperties": {
                "$ref": "https://twinfile.org/schemas/1/defs.json#/$defs/argDef"
              }
            },
            "mode": {
              "enum": ["daily", "resilience"],
              "description": "Workbench catalog mode (default resilience). Daily events cover everyday operations."
            },
            "catalog": { "type": "object" },
            "layers": { "type": "array", "items": { "type": "string" } }
          }
        }
      ]
    },
    "headComposeSteps": {
      "description": "Ordered patches for non-place twin heads (RFC 0009 extension).",
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["copy"],
            "properties": {
              "copy": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "minProperties": 1,
            "not": { "required": ["copy"] },
            "properties": { "mode": { "enum": ["patch", "replace"] } }
          }
        ]
      }
    },
    "characterTwinfile": {
      "allOf": [
        { "$ref": "https://twinfile.org/schemas/1/defs.json#/$defs/twinfileHead" },
        {
          "type": "object",
          "required": ["disclosure"],
          "properties": {
            "kind": { "const": "character" },
            "from": { "$ref": "https://twinfile.org/schemas/1/defs.json#/$defs/twinfileRef" },
            "steps": { "$ref": "#/$defs/headComposeSteps" },
            "character": { "type": "object" },
            "disclosure": { "type": "object" }
          }
        }
      ]
    },
    "storyTwinfile": {
      "allOf": [
        { "$ref": "https://twinfile.org/schemas/1/defs.json#/$defs/twinfileHead" },
        {
          "type": "object",
          "properties": {
            "kind": { "const": "story" },
            "from": { "$ref": "https://twinfile.org/schemas/1/defs.json#/$defs/twinfileRef" },
            "steps": { "$ref": "#/$defs/headComposeSteps" },
            "mode": { "enum": ["daily", "resilience"] },
            "story": { "type": "object" }
          }
        }
      ]
    },
    "resourceTwinfile": {
      "allOf": [
        { "$ref": "https://twinfile.org/schemas/1/defs.json#/$defs/twinfileHead" },
        {
          "type": "object",
          "properties": {
            "kind": { "const": "resource" },
            "from": { "$ref": "https://twinfile.org/schemas/1/defs.json#/$defs/twinfileRef" },
            "steps": { "$ref": "#/$defs/headComposeSteps" },
            "resource": { "type": "object" }
          }
        }
      ]
    },
    "scenarioTwinfile": {
      "allOf": [
        { "$ref": "https://twinfile.org/schemas/1/defs.json#/$defs/twinfileHead" },
        {
          "type": "object",
          "required": ["from"],
          "properties": {
            "kind": { "const": "scenario" },
            "mode": {
              "enum": ["daily", "resilience"],
              "description": "Use mode the scenario answers for (default resilience). Daily scenarios keep the timeline in daily mode."
            },
            "from": { "type": "string" },
            "steps": { "$ref": "#/$defs/placeSteps" },
            "args": { "type": "object", "additionalProperties": true },
            "schedule": {
              "description": "Phase start offsets per copied event (`<event-id>: { <phase>: <ISO-8601 duration> }`); unscheduled phases are left to the simulator.",
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": { "type": "string" }
              }
            },
            "t0": { "type": "string" },
            "clock": { "$ref": "https://twinfile.org/schemas/1/defs.json#/$defs/clock" },
            "metrics": { "type": "array", "items": { "type": "string" } },
            "use": {
              "type": "object",
              "required": ["runner"],
              "properties": {
                "runner": { "type": "string" },
                "runners": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["id", "runner"],
                    "properties": {
                      "id": { "$ref": "https://twinfile.org/schemas/1/defs.json#/$defs/twinId" },
                      "runner": { "type": "string", "minLength": 1 }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            },
            "patch": {
              "$ref": "https://twinfile.org/schemas/1/patch/patch-graph.schema.json"
            }
          }
        },
        {
          "properties": {
            "twinfile": { "const": 2 },
            "include": false,
            "layers": false
          },
          "required": ["twinfile", "steps"]
        }
      ]
    }
  }
}
