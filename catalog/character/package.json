    "check": "yarn typecheck && yarn test"
  },
  "dependencies": {
    "@doppler-group/twinfile-context": "workspace:^",
    "@doppler-group/twinfile-core": "workspace:packages/core",
    "chance": "^1.1.12",
    "js-yaml": "^4.1.0",
    "nanoid": "^5.1.5",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/chance": "^1.1.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.12"
  }
}
