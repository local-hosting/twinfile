{
  "name": "@doppler-group/twinfile-character",
  "version": "0.0.1",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/doppler-group/twinfile.git",
    "directory": "catalog/character"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./module": "./src/twin-module.ts",
    "./persona": {
      "development": "./src/contract/persona/index.ts",
      "default": "./src/contract/persona/index.ts"
    },
    "./persona/*": "./src/contract/persona/*",
    "./persona/browser": "./src/contract/persona/browser.ts"
  },
  "scripts": {
    "test": "vitest run",
