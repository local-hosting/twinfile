{
  "name": "@local-hosting/twinfile-story",
  "version": "0.0.1",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/local-hosting/twinfile.git",
    "directory": "catalog/story"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./module": "./src/twin-module.ts",
    "./narrative": {
      "development": "./src/contract/narrative/index.ts",
      "default": "./src/contract/narrative/index.ts"
    },
    "./narrative/*": "./src/contract/narrative/*",
    "./narrative/browser": "./src/contract/narrative/browser.ts"
  },
  "peerDependencies": {
    "@local-hosting/twinfile-character": "workspace:^",
    "@local-hosting/twinfile-context": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@local-hosting/twinfile-character": {
      "optional": false
    },
    "@local-hosting/twinfile-context": {
      "optional": false
    }
  },
  "dependencies": {
    "@local-hosting/twinfile-core": "workspace:packages/core",
    "chance": "^1.1.12",
    "js-yaml": "^4.1.0",
    "zod": "^4.1.11"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "yarn typecheck && yarn test"
  },
  "devDependencies": {
    "@local-hosting/twinfile-character": "workspace:^",
    "@local-hosting/twinfile-context": "workspace:^",
    "@types/chance": "^1.1.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.12"
  }
}
