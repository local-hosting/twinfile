{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "customConditions": ["development"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@doppler-group/twinfile-core": ["../packages/core/src/index.ts"],
      "@doppler-group/twinfile-core/cli": ["../packages/core/src/cli/twinfile-cli.ts"]
    },
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
