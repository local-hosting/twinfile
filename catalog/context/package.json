{
  "name": "@doppler-group/twinfile-context",
  "version": "0.0.1",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/doppler-group/twinfile.git",
    "directory": "catalog/context"
  },
  "type": "module",
  "exports": {
    ".": {
      "browser": "./src/contract/browser.ts",
      "default": "./src/contract/index.ts"
    },
    "./module": "./src/twin-module.ts",
    "./browser": "./src/contract/browser.ts",
    "./catalog/*": "./src/contract/catalog/*",
    "./types/*": "./src/contract/types/*",
    "./schemas/*": "./src/contract/schemas/*",
    "./jtbd/*": "./src/contract/jtbd/*",
    "./job/*": "./src/contract/job/*",
    "./contract/*": "./src/contract/contract/*"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "yarn typecheck && yarn test"
  },
  "dependencies": {
    "@doppler-group/twinfile-core": "workspace:packages/core",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.12"
  }
}
