{
  "name": "@local-hosting/twinfile-workspace",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/local-hosting/twinfile.git"
  },
  "packageManager": "yarn@4.9.2",
  "workspaces": [
    "packages/twinfile",
    "packages/tooling",
    "packages/site"
  ],
  "scripts": {
    "workbench": "node packages/twinfile/src/simulator/viewer/scripts/run-view.mjs",
    "check": "yarn run check:twinfile",
    "check:twinfile": "node packages/tooling/scripts/check-nested-yarn.mjs && node packages/tooling/scripts/check-workspace.mjs",
    "hygiene": "node packages/tooling/scripts/repo-hygiene.mjs",
    "build:publish": "yarn workspace @local-hosting/twinfile build",
    "test": "yarn workspace @local-hosting/twinfile test",
    "typecheck": "yarn workspace @local-hosting/twinfile exec tsc -p src/core/tsconfig.json --noEmit"
  },
  "resolutions": {
    "@local-hosting/geotypes": "portal:../../local-hosting/geotypes"
  },
  "license": "MPL-2.0"
}
